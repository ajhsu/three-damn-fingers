// A second Worker, because a static site cannot redirect by host name.
{
  "name": "threedamnfingers-www",
  "main": "worker.js",
  "compatibility_date": "2026-11-16",
  "routes": [{ "pattern": "www.threedamnfingers.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false }
}
